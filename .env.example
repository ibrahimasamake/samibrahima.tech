# Copy to .env.local for local development. Never commit real values.

# Public URL of the site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.samibrahima.tech

# Optional. Web3Forms access key (https://web3forms.com): forms are emailed to the
# inbox the key was created for. This key is public by design.
# Without it, submitting a form opens the visitor's email app with the message ready.
NEXT_PUBLIC_WEB3FORMS_KEY=
