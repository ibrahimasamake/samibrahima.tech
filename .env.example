# Copy to .env.local for local development. Never commit real values.

# Public URL of the site (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.samibrahima.tech

# --- Email delivery for the enquiry and contact forms (server-side only) ---
# Create a key at https://resend.com/api-keys and verify samibrahima.tech as a sending domain.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separated for several).
CONTACT_TO_EMAIL=ibsamk17@gmail.com
# Sender on the verified domain.
CONTACT_FROM_EMAIL="Samibrahima.tech <hello@samibrahima.tech>"
